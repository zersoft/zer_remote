{
  "name": "zer-remote",
  "version": "1.0.0",
  "description": "Web-based Remote Access and Screen Sharing Application like AnyDesk & TeamViewer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:exe": "npx @yao-pkg/pkg . --out-path dist",
    "build:win": "electron-builder --win nsis portable"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/index.html",
      "public/styles.css",
      "public/app.js",
      "public/assets/**/*"
    ],
    "targets": [
      "node20-win-x64",
      "node20-win-arm64"
    ],
    "outputPath": "dist"
  },
  "build": {
    "appId": "com.zer.remote",
    "productName": "ZerRemote",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZerRemote Uzak Erişim"
    },
    "files": [
      "server.js",
      "electron-main.js",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
